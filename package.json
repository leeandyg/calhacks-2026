{
  "name": "spatial-soundscape",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "check:gemini": "node --env-file=.env scripts/check-gemini.mjs",
    "check:placement": "node scripts/check-placement.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:resolver": "node scripts/check-resolver.mjs",
    "check:reverb": "node scripts/check-reverb.mjs",
    "preview": "vite preview",
    "sounds:fetch": "node --env-file=.env scripts/fetch-freesound.mjs",
    "sounds:pack": "node scripts/pack.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:frontend": "node scripts/frontend-test.mjs",
    "test:window": "node scripts/window-edge-test.mjs",
    "test:prompt": "node scripts/prompt-test.mjs",
    "art:build": "node scripts/pixel-room.mjs build",
    "art:lint": "node scripts/pixel-room.mjs lint",
    "art:verify": "node scripts/pixel-room.mjs verify",
    "art:serve": "node scripts/pixel-room.mjs serve",
    "predev": "node scripts/build-pxl-sandbox.mjs",
    "prebuild": "node scripts/build-pxl-sandbox.mjs",
    "check:art": "node scripts/build-pxl-sandbox.mjs && node scripts/check-art.mjs",
    "test:art": "node scripts/art-pipeline-test.mjs",
    "postinstall": "node scripts/build-pxl-sandbox.mjs",
    "test:managed": "node scripts/managed-browser-test.mjs",
    "check:managed": "node scripts/check-managed-live.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.1.14",
    "border-beam": "^1.4.1",
    "pxl-pixelart": "github:uilianks/pxl#a012fc78b92e5deff27e56bba563f22895c3916c",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.14",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "rolldown": "^1.2.15"
  }
}
