# Copy to .env and fill in. Never commit .env.
# API keys are backend-only; never prefix a secret with VITE_.

GEMINI_API_KEY=
# Optional: art planning/painting model; defaults to gemini-3.8-flash.
GEMINI_ART_MODEL=
ELEVENLABS_API_KEY=
FREESOUND_API_KEY=
CARTESIA_API_KEY=
# Optional: a voice from the Cartesia voice library, for short spoken replies.
CARTESIA_VOICE_ID=
# Moss project credentials (the old generic MOSS_API_KEY placeholder is not used).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Convex save/load. The CLI writes these to ignored .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# VITE_CONVEX_URL is a public deployment URL, not a secret.
# JWT_PRIVATE_KEY and JWKS belong in the Convex deployment, not this file.
# Generate them with npm run convex:auth while convex dev is running.

# Alternative backend for future shared rooms
SPACETIMEDB_URI=
