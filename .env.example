# Copy to .env and fill in. Never commit .env.
# API keys are backend-only; never prefix a secret with VITE_.

# World director, ?mode=cloud (the default and the live site): Claude Managed Agents.
# The agent and environment IDs default to the team's; set them only to use another agent.
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_ID=agent_01WGVB1ZMdiMn6AnYCBFoA6s
ANTHROPIC_ENVIRONMENT_ID=env_01RH8BZJsEg575kueEnaFAXj

# Optional self-hosted worker, ?mode=local only (its owner runs it; most of the team doesn't).
# Start it with docker compose -f compose.agent.yaml up -d --build, then set
# WORLD_AGENT_URL=http://127.0.0.1:8787/v1. The API key is a separate shared secret, NOT the Anthropic key.
WORLD_AGENT_URL=
WORLD_AGENT_API_KEY=
# Worker-only model choice. Same model/low effort as AGENT_CONFIG.yaml.
WORLD_AGENT_MODEL=claude-opus-5-5

# Gemini: the fallback when Claude is unavailable, and the engine when Anthropic is not configured.
GEMINI_API_KEY=
# Optional: art planning/painting model; defaults to gemini-3.8-flash.
GEMINI_ART_MODEL=
# ElevenLabs: only for live sound generation, which is off by default.
ELEVENLABS_API_KEY=
# Live ElevenLabs generation for sounds the library lacks: off unless set to "on" (public flag, not a secret).
VITE_ELEVENLABS_SOUNDS=
FREESOUND_API_KEY=
CARTESIA_API_KEY=
# Optional: a voice from the Cartesia voice library, for short spoken replies.
CARTESIA_VOICE_ID=
# Moss project credentials (the old generic MOSS_API_KEY placeholder is not used).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Convex save/load. The CLI writes these to ignored .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# VITE_CONVEX_URL is a public deployment URL, not a secret.
# JWT_PRIVATE_KEY and JWKS belong in the Convex deployment, not this file.
# Generate them with npm run convex:auth while convex dev is running.

# Unused: alternative backend for shared rooms, which weren't built.
SPACETIMEDB_URI=
