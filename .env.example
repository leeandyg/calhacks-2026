# Copy to .env and fill in. Never commit .env.
# These are read by the backend only; do not prefix with VITE_ (that would ship them to the browser).

# Self-hosted world director (recommended). Start with docker compose -f compose.agent.yaml up -d --build.
# App -> worker; this is a separate shared secret, NOT the Anthropic key.
WORLD_AGENT_URL=http://127.0.0.1:8787/v1
WORLD_AGENT_API_KEY=
# Worker-only model choice. Same model/low effort as AGENT_CONFIG.yaml.
WORLD_AGENT_MODEL=claude-opus-5-5

# Model inference still uses Anthropic. The agent loop and builds run in your worker.
# Clear WORLD_AGENT_URL to explicitly roll back to Claude Managed Agents.
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_ID=agent_01WGVB1ZMdiMn6AnYCBFoA6s
ANTHROPIC_ENVIRONMENT_ID=env_01RH8BZJsEg575kueEnaFAXj

# Gemini remains available when Anthropic is not configured.
GEMINI_API_KEY=
# Optional: art planning/painting model; defaults to gemini-3.8-flash.
GEMINI_ART_MODEL=
ELEVENLABS_API_KEY=
FREESOUND_API_KEY=
CARTESIA_API_KEY=
MOSS_API_KEY=

# Realtime/state (pick one)
CONVEX_DEPLOYMENT=
SPACETIMEDB_URI=
